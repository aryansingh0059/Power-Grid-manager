# ─── FRONTEND ENVIRONMENT CONFIGURATION ──────────────────────────────────────

# VITE_API_BASE_URL: Public URL of the backend REST API & Socket.IO server.
# - For Local Docker Compose: Leave blank (Nginx proxy handles /api and /socket.io)
# - For Production Deployment (e.g. Vercel + Render backend):
#   Set to your public backend URL, e.g. https://your-backend-name.onrender.com
VITE_API_BASE_URL=
