# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# Local dev: start MongoDB with `docker compose up mongo` or point at Atlas.
MONGO_URI=mongodb://localhost:27017/pgm

# ─── AI (optional) ────────────────────────────────────────────────────────────
# Used only for operator-facing incident summaries.
# If unset, the system falls back to deterministic template-based summaries.
# The application is fully functional without this key.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ─── Frontend (Vite build-time) ───────────────────────────────────────────────
# In Docker the nginx reverse-proxy handles routing; this is only needed for
# direct Vite dev server usage pointing at a remote backend.
# VITE_API_BASE_URL=http://localhost:4000
