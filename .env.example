# ─── Server ───────────────────────────────────────────────────────────────────
# PORT (Required, default: 4000): Backend Express HTTP server listening port.
PORT=4000

# NODE_ENV (Required, default: development): Node runtime mode ('development' | 'production').
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# MONGO_URI (Required): MongoDB connection string.
# - For Docker Compose deployment: mongodb://mongo:27017/pgm
# - For Local Host development:   mongodb://localhost:27017/pgm
MONGO_URI=mongodb://localhost:27017/pgm

# ─── AI Integration (Optional) ────────────────────────────────────────────────
# OPENAI_API_KEY (Optional, safe default: empty):
# OpenAI API Key used for operator-facing incident summary generation.
# If omitted or left empty, the application automatically degrades gracefully to deterministic template summaries.
# Core application functionality does NOT require an API key.
# OPENAI_API_KEY=

# OPENAI_MODEL (Optional, default: gpt-4o-mini): OpenAI model identifier.
# OPENAI_MODEL=gpt-4o-mini

# ─── Frontend Build (Optional) ────────────────────────────────────────────────
# VITE_API_BASE_URL (Optional, safe default: empty):
# Base URL for frontend API requests.
# Leave blank when running under Docker Compose so Nginx handles reverse proxying to /api and /socket.io.
# VITE_API_BASE_URL=
