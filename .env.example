# ─── POWER GRID MANAGER MONOREPO ENVIRONMENT TEMPLATE ───────────────────────

# ─── Backend Service ────────────────────────────────────────────────────────
# PORT (Default: 4000): Backend HTTP API port
PORT=4000

# NODE_ENV ('development' | 'production'): Node runtime mode
NODE_ENV=production

# MONGO_URI (Required): MongoDB Atlas or local connection string
# Docker Compose: mongodb://mongo:27017/pgm
# Local Dev:       mongodb://localhost:27017/pgm
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pgm?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/pgm

# ─── Frontend Service ───────────────────────────────────────────────────────
# VITE_API_BASE_URL (Optional): Public backend URL for cross-origin deployment
# Leave blank for local Docker Compose (Nginx reverse proxying)
# Set to https://your-backend.onrender.com when deploying SPA on Vercel/Netlify
# VITE_API_BASE_URL=
